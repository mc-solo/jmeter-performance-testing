# Optional local overrides for this repo. Copy to .env (git-ignored) and
# source it before running, or export the values by hand.
#
# JMeter does NOT read this file directly. These variables are only a
# convenient place to keep values that the run commands in docs/SETUP.md
# pass to JMeter with -J flags. Nothing here is a secret: the target is a
# public fake API and there are no credentials in this repo.
#
# Example: source .env && jmeter -p config/user.properties -Jhost="$TARGET_HOST" ...

# Path to your local JMeter install (so `jmeter` resolves without editing PATH)
JMETER_HOME=/path/to/apache-jmeter-5.6.3

# Target API host, protocol and port (defaults match config/user.properties)
TARGET_HOST=jsonplaceholder.typicode.com
TARGET_PROTOCOL=https
TARGET_PORT=443

# Load-test overrides (defaults: 10 threads, 10 s ramp-up, 5 loops)
LOAD_THREADS=10
LOAD_RAMPUP=10
LOAD_LOOPS=5

# Stress-test overrides (defaults: 50 threads, 30 s ramp-up, 10 loops)
STRESS_THREADS=50
STRESS_RAMPUP=30
STRESS_LOOPS=10

# Spike-test overrides (defaults: 100 threads, 5 s ramp-up, 45 s duration, loops forever until duration ends)
SPIKE_THREADS=100
SPIKE_RAMPUP=5
SPIKE_DURATION=45
SPIKE_LOOPS=-1
